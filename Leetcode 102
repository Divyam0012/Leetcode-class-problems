class Solution {
    List<List<Integer>> ans;

    public List<List<Integer>> levelOrder(TreeNode root) {
        ans = new ArrayList<>();

        DFS(root, 0);
        return ans;
    }

    public void DFS(TreeNode root, int a){
        if(root == null) return;    

        if(ans.size() == a){
            ans.add(new ArrayList<>()); 
        }
        ans.get(a).add(root.val);   
        DFS(root.left, a+1);    
        DFS(root.right, a+1);
        
    }
}
